<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen" style="@style/Screen">
    <Button android:id="@+id/backButton" style="@style/TextButton" android:text="@string/back" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
            <TextView android:id="@+id/detailName" style="@style/Heading" />
            <TextView android:id="@+id/detailStatus" style="@style/Body" android:textColor="@color/green" />
            <TextView style="@style/Label" android:text="@string/ingredients_heading" />
            <TextView android:id="@+id/detailIngredients" style="@style/Body" android:textColor="@color/text" android:textIsSelectable="true" />
            <TextView style="@style/Label" android:text="@string/method_heading" />
            <TextView android:id="@+id/detailMethod" style="@style/Body" android:textColor="@color/text" android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
