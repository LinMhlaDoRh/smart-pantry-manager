<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:background="@drawable/card_background"
    android:foreground="?attr/selectableItemBackground" android:orientation="vertical"
    android:padding="20dp" android:minHeight="92dp" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/recipeName" style="@style/Body" android:layout_marginTop="0dp"
        android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text" />
    <TextView android:id="@+id/recipeSummary" style="@style/Body" />
</LinearLayout>
