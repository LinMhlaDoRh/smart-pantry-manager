<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen" style="@style/Screen">
    <TextView style="@style/Heading" android:text="@string/recipes_title" />
    <TextView style="@style/Body" android:text="@string/recipes_subtitle" />
    <TextView android:id="@+id/recipeCount" style="@style/Body" android:layout_marginBottom="16dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recipeList"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" />
    <TextView android:id="@+id/emptyRecipes" style="@style/Body"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:padding="24dp" android:text="@string/recipes_empty" android:visibility="gone" />
    <include layout="@layout/navigation" />
</LinearLayout>
